agents/
command/
commands/
gsd-core/
hooks/
gsd-file-manifest.json
gsd-install-state.json
gsd-migration-journal/
.gsd-profile
.gsd-staging/
skills/gsd-*/
scripts/changeset/
scripts/lib/
