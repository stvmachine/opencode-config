{
	"$schema": "https://opencode.ai/config.json",
	"plugins": [
		"compound-engineering@git+https://github.com/EveryInc/compound-engineering-plugin.git",
		"oh-my-opencode-slim",
		"opencode-with-claude",
	],
	"agents": {
		"general": {
			"disabled": true,
		},
	},
	"providers": {
		"anthropic": {
			"settings": {
				"baseURL": "http://127.0.0.1:3456",
				"apiKey": "dummy",
			},
		},
		"kimi-for-coding": {
			"package": "@ai-sdk/openai-compatible",
			"name": "Kimi For Coding",
			"settings": {
				"baseURL": "https://api.kimi.ai/coding/v1",
				"apiKey": "{file:~/.config/opencode/secrets/kimi_api_key}",
			},
			// Model ids are the endpoint's own (GET /coding/v1/models), not "kimi-"
			// prefixed; opencode only sees what is declared here.
			"models": {
				"kimi-for-coding": {
					"name": "Kimi For Coding (K2.8 Preview)",
					"limit": { "context": 262144, "output": 65536 },
					// Lets the observer agent send it slide and screenshot images.
					"modalities": { "input": ["text", "image"], "output": ["text"] },
				},
				"k3.1-pro": {
					"name": "Kimi K3.1 Pro",
					"limit": { "context": 1048576, "output": 65536 },
					"modalities": { "input": ["text", "image"], "output": ["text"] },
				},
			},
		},
	},
	"lsp": true,
	"skills": ["~/.config/opencode/skills"],
	"mcp": {
		"servers": {
			"supabase": {
				"type": "remote",
				"url": "https://mcp.supabase.com/mcp",
			},
			"github": {
				"type": "local",
				"command": ["npx", "-y", "@modelcontextprotocol/server-github"],
				"environment": {
					"GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/secrets/github_token}",
				},
			},
			// Disabled: re-enable by uncommenting (needs secrets/stitch_api_key).
			// "stitch": {
			// 	"type": "remote",
			// 	"url": "https://stitch.googleapis.com/mcp",
			// 	"headers": {
			// 		"X-Goog-Api-Key": "{file:~/.config/opencode/secrets/stitch_api_key}",
			// 	},
			// },
			"gsd": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"-p",
					"@opengsd/gsd-core",
					"gsd-mcp-server",
					"--no-prompts",
				],
			},
			// Disabled: re-enable by uncommenting (needs secrets/hass_token).
			// "homeassistant": {
			// 	"type": "local",
			// 	"command": ["hass-mcp"],
			// 	"environment": {
			// 		"HASS_URL": "http://192.168.20.30:8123",
			// 		"HASS_TOKEN": "{file:~/.config/opencode/secrets/hass_token}",
			// 	},
			// },
			// Stdio bridge: Claude Design rejects opencode's built-in OAuth (no DCR/metadata).
			// One-time sign-in (re-run if it expires): node ~/.config/opencode/scripts/claude-design-mcp.mjs login
			"claude_design": {
				"type": "local",
				"command": ["node", "{env:HOME}/.config/opencode/scripts/claude-design-mcp.mjs"],
			},
			"firecrawl": {
				"type": "local",
				"command": ["npx", "-y", "firecrawl-mcp"],
				"environment": {
					"FIRECRAWL_API_KEY": "{file:~/.config/opencode/secrets/firecrawl_api_key}",
				},
			},
			"codegraph": {
				"type": "local",
				"command": ["npx", "-y", "@colbymchenry/codegraph", "serve", "--mcp"],
			},
			// sooperset/mcp-atlassian, Confluence only (no JIRA_* vars). Drop READ_ONLY_MODE to allow writes.
			"confluence": {
				"type": "local",
				"command": ["uvx", "mcp-atlassian"],
				"environment": {
					"CONFLUENCE_URL": "https://socialtraders.atlassian.net/wiki",
					"CONFLUENCE_USERNAME": "esteban.campos@socialtraders.com.au",
					"CONFLUENCE_API_TOKEN": "{file:~/.config/opencode/secrets/atlassian_key}",
					"READ_ONLY_MODE": "true",
				},
			},
		},
	},
	"permissions": [
		{ "action": "read", "resource": "*", "effect": "allow" },
		{ "action": "read", "resource": "*.env", "effect": "deny" },
		{ "action": "read", "resource": "*.env.*", "effect": "deny" },
		{ "action": "read", "resource": "*.env.example", "effect": "allow" },
		{ "action": "read", "resource": "~/.config/opencode/gsd-core/*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/**/*", "effect": "allow" },
		{
			"action": "external_directory",
			"resource": "~/.config/opencode/gsd-core/*",
			"effect": "allow",
		},
	],
}
