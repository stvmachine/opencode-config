#!/usr/bin/env bash
# Shared OH_MY_OPENCODE_SLIM_PRESET derivation for profiles/bin/oc-* wrappers.
#
# Usage (from a wrapper in this directory):
#   source "$(dirname "${BASH_SOURCE[0]}")/oc-slim-preset"
#
# Resolution order:
#   1. OCX_PROFILE when set (OCX provides it at runtime)
#   2. An explicit OH_MY_OPENCODE_SLIM_PRESET override
#   3. The wrapper basename: oc-<name> -> <name>
# The profile name "default" maps to the "sol-kimi" preset.

if [[ -n "${OCX_PROFILE:-}" ]]; then
  _oc_slim_preset="$OCX_PROFILE"
elif [[ -n "${OH_MY_OPENCODE_SLIM_PRESET:-}" ]]; then
  _oc_slim_preset="$OH_MY_OPENCODE_SLIM_PRESET"
else
  _oc_slim_wrapper="${BASH_SOURCE[1]:-$0}"
  _oc_slim_preset="${_oc_slim_wrapper##*/}"
  _oc_slim_preset="${_oc_slim_preset#oc-}"
fi

if [[ "$_oc_slim_preset" == "default" ]]; then
  _oc_slim_preset="sol-kimi"
fi

export OH_MY_OPENCODE_SLIM_PRESET="$_oc_slim_preset"
unset _oc_slim_preset _oc_slim_wrapper
